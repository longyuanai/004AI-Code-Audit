{
  "description": "Cross-stack contract for inline codeguard-ignore directives. src/scanner/suppression.ts (TypeScript) and src/ai_code_audit/postprocess.py (Python) must parse and apply directives identically. tests/unit/suppression-contract.test.ts and tests/test_suppression_contract.py each read this file: directiveCases through the directive parser, filterCases through the real filtering entry points (filterSuppressed / filter_suppressed).",
  "version": 1,
  "grammar": {
    "keywords": {
      "sameLine": "codeguard-ignore",
      "nextLine": "codeguard-ignore-next-line",
      "caseSensitive": true,
      "boundary": "A keyword is recognised only when not preceded by [A-Za-z0-9_-] and not followed by [A-Za-z0-9_-], so xcodeguard-ignore, not_codeguard-ignore, codeguard-ignored and codeguard-ignore-list.md are not directives."
    },
    "ruleIdSyntax": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)+$, case-insensitive, compared upper-cased",
    "ruleIdLookalike": "^[A-Za-z0-9]+- (something that starts like a rule id but is not one, e.g. CG-002. or CG-)",
    "recognizedNamespaces": [
      "CG-",
      "004-"
    ],
    "separators": "Commas and canonical whitespace (the canonicalWhitespace set in contracts/fingerprint.json).",
    "reasonDelimiters": [
      "--",
      "—"
    ],
    "rules": [
      "1. Nothing after the keyword, or a reason delimiter immediately after it, is a bare directive: every rule on the target line is suppressed.",
      "2. Otherwise the text after the keyword is a rule-id list: ids separated by commas and/or whitespace. Only the listed rules are suppressed.",
      "3. A reason delimiter ends the list; everything after it is free text and is never inspected.",
      "4. The first item must be a syntactically valid rule id. If it is not, the directive is invalid.",
      "5. After a comma the next item must be a valid rule id, or the directive is invalid.",
      "6. After whitespace only, the next item may be a valid rule id (the list continues), a rule-id lookalike (the directive is invalid), or anything else (legacy undelimited reason: the list ends there).",
      "7. An invalid directive suppresses nothing. The finding is kept and a diagnostic is reported. It never falls back to suppressing every rule and never applies a partial list.",
      "8. A syntactically valid id outside the recognized namespaces and not in the caller's known rule ids is kept in the list (it simply matches no finding) and produces an 'unrecognized' diagnostic.",
      "9. With inline suppression disabled no directive is parsed, every finding is kept and no diagnostic is reported."
    ],
    "diagnostics": {
      "invalid": "invalid codeguard-ignore directive: unexpected token {token}; it suppresses nothing (put \"--\" before a free-text reason)",
      "unrecognized": "codeguard-ignore names unrecognized rule id {id}; it matches no rule",
      "quoting": "{token} and {id} are rendered in double quotes; backslash and double quote are backslash-escaped, and U+0000-U+001F, U+007F-U+009F and unpaired surrogates are written as \\uXXXX (lowercase hex), so a crafted comment cannot inject terminal control sequences into CI logs.",
      "location": "Diagnostics point at the directive's own line (for next-line directives, the line above the finding). The Python envelope and the TypeScript CLI render them as \"{path}:{line}: {message}\". One diagnostic per directive line and message, however many findings it affects, sorted by line then message. Diagnostics are reported only for directives that target a line with a finding."
    }
  },
  "directiveCases": [
    {
      "name": "bare",
      "line": "danger(x); // codeguard-ignore",
      "sameLine": {
        "kind": "all"
      },
      "nextLine": null
    },
