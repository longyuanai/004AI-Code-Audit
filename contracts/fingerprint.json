  "compatibility": {
    "summary": "v1 keeps its meaning: the key and baseline version are unchanged. The only inputs whose fingerprint differs from the pre-contract implementations are listed here, so no change is silent.",
    "typescript": {
      "changedVectors": {
        "windows-path": {
          "before": "c8119030c50feefa",
          "after": "f9a3248de0b2bafa"
        },
        "mixed-separators": {
          "before": "cf106fc1e2207b36",
          "after": "f9a3248de0b2bafa"
        }
      },
      "impact": "Only a Finding.file containing a backslash changes. The orchestrator builds Finding.file with relative(...).replace(/\\\\/g, '/'), so no baseline or SARIF fingerprint written by the CLI is affected."
    },
    "python": {
      "changedVectors": {
        "ws-feff-collapsed": {
          "before": "f3320f566f558fe5",
          "after": "be01fedac4053f4f"
