# Optional existing shared-llm-core provider (never commit real credentials).
# The Web process reads this file through the existing shared config loader.
LLM_PROVIDERS=
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_DEFAULT_MODEL=
LLM_LOCAL_API_KEY=no-key-required
LLM_LOCAL_TIMEOUT_S=15
LLM_LOCAL_MAX_RETRIES=0
LLM_AUDIT_INCLUDE_PROMPT=false
LLM_AUDIT_INCLUDE_RESPONSE=false
AUDIT_WEB_PORT=8765
AUDIT_WEB_DATA_DIR=artifacts/web-data
